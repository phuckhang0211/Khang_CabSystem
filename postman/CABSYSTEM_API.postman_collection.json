    {
      "name": "Booking+Payment",
      "item": [
        {
          "name": "Create booking with new customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const stamp=Date.now();pm.environment.set('idemKey',`postman-${stamp}`);pm.environment.set('providerTxnId',`POSTMAN-TXN-${stamp}`);pm.environment.set('pollCount','0');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 payment pending',()=>{pm.response.to.have.status(201);const d=pm.response.json().data;pm.expect(d.status).to.eql('PAYMENT_PENDING');pm.expect(d.fare).to.be.a('number');pm.environment.set('bookingId',d.bookingId);pm.environment.set('paymentId',d.paymentId);pm.environment.set('fare',String(d.fare));});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{newCustomerToken}}"
              },
              { "key": "Idempotency-Key", "value": "{{idemKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"pickup\":{\"lat\":10.762622,\"lng\":106.660172,\"address\":\"postman-pickup\"},\"destination\":{\"lat\":10.776889,\"lng\":106.700806,\"address\":\"postman-destination\"}}"
            },
            "url": "{{baseUrl}}/bookings"
          }
        },
        {
          "name": "Replay booking same key and body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{newCustomerToken}}"
              },
              { "key": "Idempotency-Key", "value": "{{idemKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"pickup\":{\"lat\":10.762622,\"lng\":106.660172,\"address\":\"postman-pickup\"},\"destination\":{\"lat\":10.776889,\"lng\":106.700806,\"address\":\"postman-destination\"}}"
            },
            "url": "{{baseUrl}}/bookings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 replay same ids',()=>{pm.response.to.have.status(201);const d=pm.response.json().data;pm.expect(d.bookingId).to.eql(pm.environment.get('bookingId'));pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true');});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reuse key with different body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{newCustomerToken}}"
              },
              { "key": "Idempotency-Key", "value": "{{idemKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"pickup\":{\"lat\":10.762622,\"lng\":106.660172},\"destination\":{\"lat\":10.780000,\"lng\":106.672000}}"
            },
            "url": "{{baseUrl}}/bookings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('422 reused key',()=>{pm.response.to.have.status(422);pm.expect(pm.response.json().error.code).to.eql('IDEMPOTENCY_KEY_REUSED');});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create booking without idempotency key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{newCustomerToken}}"
              },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"pickup\":{\"lat\":10.762622,\"lng\":106.660172},\"destination\":{\"lat\":10.776889,\"lng\":106.700806}}"
            },
            "url": "{{baseUrl}}/bookings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 missing key',()=>pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET pending booking",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{newCustomerToken}}" }
            ],
            "url": "{{baseUrl}}/bookings/{{bookingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 pending booking',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().data.status).to.eql('PAYMENT_PENDING');});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET pending payment",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{newCustomerToken}}" }
            ],
            "url": "{{baseUrl}}/payments/{{paymentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 pending payment',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().data.status).to.eql('PENDING');});",
                  "const paymentId=pm.environment.get('paymentId'),providerTxnId=pm.environment.get('providerTxnId'),key=pm.environment.get('PAYMENT_CALLBACK_SECRET');pm.environment.set('signature',CryptoJS.HmacSHA256(`${paymentId}|${providerTxnId}-amount|1|SUCCESS`,key).toString(CryptoJS.enc.Hex));"
                ]
              }
            }
          ]
        },
        {
          "name": "Callback invalid signature",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"paymentId\":\"{{paymentId}}\",\"providerTxnId\":\"{{providerTxnId}}-bad\",\"amount\":{{fare}},\"result\":\"SUCCESS\",\"signature\":\"invalid\"}"
            },
            "url": "{{baseUrl}}/payments/mock/callback"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 invalid signature',()=>{pm.response.to.have.status(400);pm.expect(pm.response.json().error.code).to.eql('INVALID_SIGNATURE');});"
                ]
              }
            }
          ]
        },
        {
          "name": "Callback invalid amount",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const paymentId=pm.environment.get('paymentId'),providerTxnId=`${pm.environment.get('providerTxnId')}-amount`,amount=1,result='SUCCESS';const s=`${paymentId}|${providerTxnId}|${amount}|${result}`;const signature=CryptoJS.HmacSHA256(s,pm.environment.get('PAYMENT_CALLBACK_SECRET')).toString(CryptoJS.enc.Hex);pm.variables.set('signature',signature);pm.environment.set('signature',signature);pm.request.body.update(JSON.stringify({paymentId,providerTxnId,amount,result,signature}));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
            "raw": "{\"paymentId\":\"{{paymentId}}\",\"providerTxnId\":\"{{providerTxnId}}-amount\",\"amount\":1,\"result\":\"SUCCESS\",\"signature\":\"{{signature}}\"}"
            },
            "url": "{{baseUrl}}/payments/mock/callback"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 invalid amount',()=>{pm.response.to.have.status(400);pm.expect(pm.response.json().error.code).to.eql('INVALID_AMOUNT');});",
                  "const paymentId=pm.environment.get('paymentId'),providerTxnId=pm.environment.get('providerTxnId'),fare=Number(pm.environment.get('fare')),key=pm.environment.get('PAYMENT_CALLBACK_SECRET');pm.environment.set('signature',CryptoJS.HmacSHA256(`${paymentId}|${providerTxnId}|${fare}|SUCCESS`,key).toString(CryptoJS.enc.Hex));"
                ]
              }
            }
          ]
        },
        {
          "name": "Callback success",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const paymentId=pm.environment.get('paymentId'),providerTxnId=pm.environment.get('providerTxnId'),amount=Number(pm.environment.get('fare')),result='SUCCESS';const s=`${paymentId}|${providerTxnId}|${amount}|${result}`;const signature=CryptoJS.HmacSHA256(s,pm.environment.get('PAYMENT_CALLBACK_SECRET')).toString(CryptoJS.enc.Hex);pm.variables.set('signature',signature);pm.environment.set('signature',signature);pm.request.body.update(JSON.stringify({paymentId,providerTxnId,amount,result,signature}));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
            "raw": "{\"paymentId\":\"{{paymentId}}\",\"providerTxnId\":\"{{providerTxnId}}\",\"amount\":{{fare}},\"result\":\"SUCCESS\",\"signature\":\"{{signature}}\"}"
            },
            "url": "{{baseUrl}}/payments/mock/callback"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 completed callback',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET completed payment",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{newCustomerToken}}" }
            ],
            "url": "{{baseUrl}}/payments/{{paymentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 completed payment',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().data.status).to.eql('COMPLETED');});"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll booking searching driver",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{newCustomerToken}}" }
            ],
            "url": "{{baseUrl}}/bookings/{{bookingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('booking progresses after callback',()=>{pm.response.to.have.status(200);const status=pm.response.json().data.status;const count=Number(pm.environment.get('pollCount')||0);if(status!=='SEARCHING_DRIVER'){pm.expect(count).to.be.below(20);pm.environment.set('pollCount',String(count+1));postman.setNextRequest('Poll booking searching driver');}else{pm.environment.set('pollCount','0');}});"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay callback",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const paymentId=pm.environment.get('paymentId'),providerTxnId=pm.environment.get('providerTxnId'),amount=Number(pm.environment.get('fare')),result='SUCCESS';const s=`${paymentId}|${providerTxnId}|${amount}|${result}`;const signature=CryptoJS.HmacSHA256(s,pm.environment.get('PAYMENT_CALLBACK_SECRET')).toString(CryptoJS.enc.Hex);pm.variables.set('signature',signature);pm.environment.set('signature',signature);pm.request.body.update(JSON.stringify({paymentId,providerTxnId,amount,result,signature}));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
            "raw": "{\"paymentId\":\"{{paymentId}}\",\"providerTxnId\":\"{{providerTxnId}}\",\"amount\":{{fare}},\"result\":\"SUCCESS\",\"signature\":\"{{signature}}\"}"
            },
            "url": "{{baseUrl}}/payments/mock/callback"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 callback replay',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
