# --- chung ---
NODE_ENV=development
API_PREFIX=/api/v1
GATEWAY_PORT=3000
GRPC_DEADLINE_MS=4000
LOG_LEVEL=info

# --- bảo mật ---
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN_SECONDS=3600
ONBOARDING_TOKEN_EXPIRES_IN_SECONDS=900
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-service-token
ENCRYPTION_KEY_V1=replace-with-base64-encoded-32-byte-key
ENCRYPTION_ACTIVE_KEY_ID=v1
BLIND_INDEX_KEY=replace-with-a-long-random-blind-index-key
BCRYPT_COST=10

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- nghiệp vụ ---
PRICE_PER_KM=5000
MATCH_RADIUS_KM=3
MATCH_MAX_OFFERS=3
OFFER_TTL_SECONDS=120
PAYMENT_CALLBACK_SECRET=replace-with-a-long-random-payment-callback-secret
PAYMENT_SKIP_SIGNATURE=false

# --- rate limit (Gateway) ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_PER_MIN=100
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_BOOKING_PER_MIN=10

# --- hạ tầng ---
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=replace-with-auth-db-password
AUTH_DB_ADDR=auth-db:5432
AUTH_DB_DEBUG_PORT=5433
AUTH_DATABASE_URL=postgres://auth_user:replace-with-auth-db-password@auth-db:5432/auth_db
CUSTOMER_DB_NAME=customer_db
CUSTOMER_DB_USER=customer_user
CUSTOMER_DB_PASSWORD=replace-with-customer-db-password
CUSTOMER_DB_ADDR=customer-db:5432
CUSTOMER_DB_DEBUG_PORT=5434
CUSTOMER_DATABASE_URL=postgres://customer_user:replace-with-customer-db-password@customer-db:5432/customer_db
DRIVER_DB_NAME=driver_db
DRIVER_DB_USER=driver_user
DRIVER_DB_PASSWORD=replace-with-driver-db-password
DRIVER_DB_ADDR=driver-db:5432
DRIVER_DB_DEBUG_PORT=5435
DRIVER_DATABASE_URL=postgres://driver_user:replace-with-driver-db-password@driver-db:5432/driver_db
BOOKING_DB_NAME=booking_db
BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=replace-with-booking-db-password
BOOKING_DB_ADDR=booking-db:5432
BOOKING_DB_DEBUG_PORT=5436
BOOKING_DATABASE_URL=postgres://booking_user:replace-with-booking-db-password@booking-db:5432/booking_db
TRIP_DB_NAME=trip_db
TRIP_DB_USER=trip_user
TRIP_DB_PASSWORD=replace-with-trip-db-password
TRIP_DB_ADDR=trip-db:5432
TRIP_DB_DEBUG_PORT=5437
TRIP_DATABASE_URL=postgres://trip_user:replace-with-trip-db-password@trip-db:5432/trip_db
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=replace-with-payment-db-password
PAYMENT_DB_ADDR=payment-db:5432
PAYMENT_DB_DEBUG_PORT=5438
PAYMENT_DATABASE_URL=postgres://payment_user:replace-with-payment-db-password@payment-db:5432/payment_db
NOTIFY_DB_NAME=notify_db
NOTIFY_DB_USER=notify_user
NOTIFY_DB_PASSWORD=replace-with-notify-db-password
NOTIFY_DB_ADDR=notify-db:5432
NOTIFY_DB_DEBUG_PORT=5439
NOTIFY_DATABASE_URL=postgres://notify_user:replace-with-notify-db-password@notify-db:5432/notify_db
REDIS_URL=redis://redis:6379
REDIS_DEBUG_PORT=6379
RABBITMQ_DEFAULT_USER=cab
RABBITMQ_DEFAULT_PASS=<random-32-byte-hex>
RABBITMQ_URL=amqp://cab:<random-32-byte-hex>@rabbitmq:5672
RABBITMQ_EXCHANGE=ride.events

# --- địa chỉ gRPC & port ---
AUTH_GRPC_PORT=50051
AUTH_GRPC_ADDR=auth-service:50051
CUSTOMER_GRPC_PORT=50052
CUSTOMER_GRPC_ADDR=customer-service:50052
DRIVER_GRPC_PORT=50053
DRIVER_GRPC_ADDR=driver-service:50053
BOOKING_GRPC_PORT=50054
BOOKING_GRPC_ADDR=booking-service:50054
TRIP_GRPC_PORT=50055
TRIP_GRPC_ADDR=trip-service:50055
PAYMENT_GRPC_PORT=50056
PAYMENT_GRPC_ADDR=payment-service:50056
NOTIFY_GRPC_PORT=50057
NOTIFY_GRPC_ADDR=notify-service:50057

# --- seed (chạy từ host) ---
SEED_BASE_LAT=10.762622
SEED_BASE_LNG=106.660172
SEED_PG_HOST=localhost
SEED_REDIS_URL=redis://localhost:6379
